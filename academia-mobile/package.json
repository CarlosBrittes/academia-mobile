{
  "name": "academia-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --test tests/*.test.cjs",
    "test:auth": "node --test tests/auth*.test.cjs",
    "test:entrega": "node --test tests/funcoes.test.cjs tests/persistencia.test.cjs",
    "test:rules": "node --test tests/rules/*.test.cjs",
    "test:emulators": "firebase emulators:exec --only firestore --project demo-studio64 \"npm run test:rules\""
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "base64-js": "^1.5.1",
    "expo": "~54.0.0",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-sharing": "~14.0.7",
    "expo-video": "~3.0.16",
    "firebase": "^12.19.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.35.0"
  }
}
